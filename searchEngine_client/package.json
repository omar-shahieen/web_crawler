{
  "name": "search-engine-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"npm:dev:backend\" \"npm:dev:client:wait\"",
    "dev:backend": "\"..\\.venv\\Scripts\\python.exe\" ..\\searchEngine_core\\main.py serve --host 127.0.0.1 --port 3001",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:client:wait": "wait-on http-get://127.0.0.1:3001/api/health && npm run dev:client",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-simple-keyboard": "^3.8.173"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "vite": "^5.0.0",
    "wait-on": "^9.0.4"
  }
}
